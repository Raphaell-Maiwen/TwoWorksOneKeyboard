.hud-root {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.row {
    flex-direction: row;
    flex-grow: 1;
}

.player-block {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

.block-text {
    color: white;
    font-size: 24px;
    -unity-text-align: middle-center;
}