.hud-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.row {
    flex-direction: row;
    justify-content: space-evenly;
    width: 100%;
    margin-top: 25px;
}

.player-block {
    background-color: rgb(3, 255, 0);
    padding: 25px;
    border-radius: 25px;
}

.block-text {
    color: white;
    font-size: 100px;
    background-color: rgb(0, 46, 255);
}
