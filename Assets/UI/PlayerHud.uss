.hud-root {
    width: 100%;
    height: 100%;
    justify-content: center;
}

.row {
    flex-direction: row;
    justify-content: space-evenly;
    width: 100%;
    margin-top: 25px;
}

.player-block {
    background-color: rgb(3, 255, 0);
    padding: 25px;
    border-radius: 25px;
}

.block-text {
    color: white;
    font-size: 106px;
    padding-top: 0;
    margin-bottom: 0;
    padding-bottom: 0;
    height: 125px;
}
